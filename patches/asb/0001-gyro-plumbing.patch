+    // --- end ApexSenseBridge-GyroAddon ---
+
     bool operator==(const DualSenseInputState&) const = default;
 };
 
diff --git a/src/motion/ApexMotionSource.cpp b/src/motion/ApexMotionSource.cpp
new file mode 100644
index 0000000..fc23aed
--- /dev/null
+++ b/src/motion/ApexMotionSource.cpp
@@ -0,0 +1,19 @@
+#include "motion/ApexMotionSource.h"
+
+namespace asb::motion {
+
+void applyApex5Motion(asb::dualsense::DualSenseInputState& state) noexcept {
+    // TODO(gyro-addon): replace with the decoded Apex 5 vendor HID read once
+    // the protocol capture is done. Left neutral (0) for now, which is safe:
+    // a real DualSense at rest reports ~0 rate-of-rotation on gyro and a
+    // gravity-only reading on accel, but 0/0/0 is an acceptable placeholder
+    // that games interpret as "controller held still".
+    state.gyroX = 0;
+    state.gyroY = 0;
+    state.gyroZ = 0;
+    state.accelX = 0;
+    state.accelY = 0;
+    state.accelZ = 0;
+}
+
+} // namespace asb::motion
diff --git a/src/motion/ApexMotionSource.h b/src/motion/ApexMotionSource.h
new file mode 100644
index 0000000..77cf420
--- /dev/null
+++ b/src/motion/ApexMotionSource.h
@@ -0,0 +1,38 @@
+#pragma once
+
+// ApexSenseBridge-GyroAddon
+//
+// Isolated hook point for Apex 5 motion (gyro/accel) data. Kept in its own
+// translation unit on purpose: everything else in this codebase is upstream
+// ReynArts/ApexSenseBridge code we track via git submodule + patches, and we
+// want future `sync-upstream` merges to touch as few upstream lines as
+// possible. Only WindowsPhysicalInputSource.cpp gets a 2-line patch (include
+// + one call); all the real reverse-engineered protocol logic lives here.
+//
+// STATUS: stub. The Apex 5's official Flydigi Space Station software can
+// clearly read motion data from the controller (confirmed: full DualSense
+// incl. gyro works when it forces DualSense mode for GTA5), but the wire
+// format is proprietary and not yet reverse engineered in this project.
+//
+// To fill this in:
+//   1. Capture raw USB/HID traffic between Flydigi Space Station and the
+//      physical Apex 5 while its DualSense+gyro mode is active (Wireshark +
+//      USBPcap, or an HID-level sniffer). Rotate the controller on isolated
+//      axes (X only, Y only, Z only) to identify which bytes move and how.
+//   2. Once decoded (report id, offset, scale, endianness, sign convention),
+//      implement the real read here instead of the neutral no-op below.
+//   3. No other file needs to change: WindowsPhysicalInputSource.cpp already
+//      calls applyApex5Motion() after every parsed report.
+
+#include "dualsense/DualSenseInput.h"
+
+namespace asb::motion {
+
+// Called once per parsed input report, right after the generic HID/XInput
+// fields are decoded. Must fill state.gyro{X,Y,Z} / state.accel{X,Y,Z} using
+// the same units/sign convention as a real DualSense USB input report (see
+// DualSenseInput.h). Currently a no-op: leaves whatever the caller already
+// set (defaults to neutral/0 from DualSenseInputState's in-class initializers).
+void applyApex5Motion(asb::dualsense::DualSenseInputState& state) noexcept;
+
+} // namespace asb::motion
