diff --git a/src/dualsense/DualSenseInput.cpp b/src/dualsense/DualSenseInput.cpp
index 0c10763..6c3b6aa 100644
--- a/src/dualsense/DualSenseInput.cpp
+++ b/src/dualsense/DualSenseInput.cpp
@@ -23,6 +23,22 @@ std::array<std::uint8_t, 33> buildViiperInput(const DualSenseInputState& state)
     input[16] = static_cast<std::uint8_t>(state.touch2Y & 0xFF);
     input[17] = static_cast<std::uint8_t>(state.touch2Y >> 8);
     input[18] = state.touch2Active ? 1 : 0;
+
+    // --- ApexSenseBridge-GyroAddon: motion plumbing (little-endian int16) ---
+    input[19] = static_cast<std::uint8_t>(state.gyroX & 0xFF);
+    input[20] = static_cast<std::uint8_t>(state.gyroX >> 8);
+    input[21] = static_cast<std::uint8_t>(state.gyroY & 0xFF);
+    input[22] = static_cast<std::uint8_t>(state.gyroY >> 8);
+    input[23] = static_cast<std::uint8_t>(state.gyroZ & 0xFF);
+    input[24] = static_cast<std::uint8_t>(state.gyroZ >> 8);
+    input[25] = static_cast<std::uint8_t>(state.accelX & 0xFF);
+    input[26] = static_cast<std::uint8_t>(state.accelX >> 8);
+    input[27] = static_cast<std::uint8_t>(state.accelY & 0xFF);
+    input[28] = static_cast<std::uint8_t>(state.accelY >> 8);
+    input[29] = static_cast<std::uint8_t>(state.accelZ & 0xFF);
+    input[30] = static_cast<std::uint8_t>(state.accelZ >> 8);
+    // --- end ApexSenseBridge-GyroAddon ---
+
     input[31] = state.batteryPercent;
     input[32] = state.chargeState;
     return input;
diff --git a/src/dualsense/DualSenseInput.h b/src/dualsense/DualSenseInput.h
