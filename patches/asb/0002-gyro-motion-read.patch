+// briefly during startup): leaves the fields at whatever the caller already
+// set (defaults to neutral/0) until the channel comes up, and retries
+// opening it periodically in the background.
 void applyApex5Motion(asb::dualsense::DualSenseInputState& state) noexcept;
 
 } // namespace asb::motion
