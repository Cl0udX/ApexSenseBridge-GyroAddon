 #include "motion/ApexMotionSource.h"
 
+#include "flydigi/Apex5Protocol.h"
+#include "platform/HidTransport.h"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <limits>
+#include <span>
+#include <string>
+#include <vector>
